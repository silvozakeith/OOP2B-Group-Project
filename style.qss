QMainWindow, QDialog {
  background-color: #f1f5f9;
    color: #1e293b;
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
}


QWidget {
    color: #334155;
    font-size: 11px;
}


/* Header Bar */
QFrame#header_bar {
    background-color: #ffffff;
    border-bottom: 1px solid #cbd5e1;
    padding: 6px 14px;
}


QLabel#brand_title {
    font-size: 15px;
    font-weight: 800;
    color: #0f172a;
}


QLabel#brand_subtitle {
    font-size: 10px;
    color: #64748b;
}


/* Navigation Buttons */
QPushButton#top_nav_btn {
    background-color: #f8fafc;
    color: #475569;
    border: 1px solid #cbd5e1;
    border-radius: 12px;
    padding: 6px 14px;
    font-weight: 600;
    font-size: 11px;
}


QPushButton#top_nav_btn:hover {
    background-color: #e2e8f0;
    color: #0f172a;
}


QPushButton#top_nav_btn[active="true"] {
    background-color: #2563eb;
    color: #ffffff;
    border: 1px solid #1d4ed8;
}


/* Card Containers */
QFrame#card_panel {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 14px;
}


/* Titles & Labels */
QLabel#card_title {
    font-size: 13px;
    font-weight: 700;
    color: #0f172a;
}


QLabel#card_subtitle {
    font-size: 10px;
    color: #64748b;
}


QLabel#field_label {
    font-size: 11px;
    font-weight: 600;
    color: #475569;
}


/* Inputs */
QLineEdit, QSpinBox {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    color: #0f172a;
    padding: 6px 10px;
    font-size: 11px;
}


QLineEdit:focus, QSpinBox:focus {
    border: 2px solid #2563eb;
}


/* Choice Buttons */
QPushButton#grid_option_btn {
    background-color: #ffffff;
    color: #334155;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 8px 12px;
    font-weight: 600;
    font-size: 11px;
    text-align: left;
}


QPushButton#grid_option_btn:hover {
    border-color: #94a3b8;
    background-color: #f8fafc;
}


QPushButton#grid_option_btn[checked="true"] {
    background-color: #eff6ff;
    border: 2px solid #2563eb;
    color: #1d4ed8;
    font-weight: 700;
}


/* Addon Boxes */
QFrame#addon_box {
    background-color: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 8px;
}


QCheckBox {
    color: #334155;
    font-weight: 600;
    font-size: 11px;
    spacing: 6px;
}


QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border-radius: 3px;
    border: 1px solid #cbd5e1;
    background-color: #ffffff;
}


QCheckBox::indicator:checked {
    background-color: #2563eb;
    border-color: #1d4ed8;
}


/* Primary Action Button */
QPushButton#primary_action_btn {
    background-color: #2563eb;
    color: #ffffff;
    font-weight: 700;
    font-size: 12px;
    border: none;
    border-radius: 6px;
    padding: 10px;
}


QPushButton#primary_action_btn:hover {
    background-color: #1d4ed8;
}


QPushButton#primary_action_btn:pressed {
    background-color: #1e40af;
}


/* Metric Cards */
QFrame#metric_card {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 10px;
}


/* Tables */
QTableWidget {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    gridline-color: #f1f5f9;
    border-radius: 6px;
    color: #334155;
    font-size: 11px;
}


QTableWidget::item {
    padding: 6px 8px;
    border-bottom: 1px solid #f1f5f9;
}


QHeaderView::section {
    background-color: #f8fafc;
    color: #64748b;
    font-weight: 700;
    font-size: 10px;
    text-transform: uppercase;
    border: none;
    border-bottom: 1px solid #cbd5e1;
    padding: 6px;
}
